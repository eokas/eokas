set(EOKAS_RUNTIME_DIR "${EOKAS_MODULES_DIR}/Runtime")
set(EOKAS_TOOLKIT_DIR "${EOKAS_MODULES_DIR}/Toolkit")
set(EOKAS_DEPS_DIR "${EOKAS_MODULES_DIR}/Deps")
set(EOKAS_TEST_DIR "${CMAKE_CURRENT_SOURCE_DIR}/Test")
set(EOKAS_BINARY_DIR "${PROJECT_BINARY_DIR}")
message("EOKAS_PROJECT_NAME = ${EOKAS_PROJECT_NAME}")
message("EOKAS_PROJECT_DIR = ${EOKAS_PROJECT_DIR}")
message("EOKAS_MODULES_DIR = ${EOKAS_MODULES_DIR}")
message("EOKAS_RUNTIME_DIR = ${EOKAS_RUNTIME_DIR}")
message("EOKAS_TOOLKIT_DIR = ${EOKAS_TOOLKIT_DIR}")
message("EOKAS_DEPS_DIR = ${EOKAS_DEPS_DIR}")
message("EOKAS_BINARY_DIR = ${EOKAS_BINARY_DIR}")


macro(eokas_runtime_module MODULE_NAME)
    message("========================================================================")
    message("== EOKAS RUNTIME MODULE: ${MODULE_NAME}")
    message("========================================================================")
    include("${EOKAS_RUNTIME_DIR}/${MODULE_NAME}/Module.Build.cmake")
endmacro()

macro(eokas_toolkit_module MODULE_NAME)
    message("========================================================================")
